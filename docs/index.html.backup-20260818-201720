  <style>
    /* =========================================================
       REQUESTED HOME-ONLY CHANGES
    ========================================================== */

    /* 1. Background image
       9:14 ratio, slightly dark — NOT heavily dark */
    .home-background-hero {
      position: relative;
      width: 100%;
      aspect-ratio: 9 / 14;
      min-height: 520px;
      max-height: 900px;
      overflow: hidden;

      background-image:
        linear-gradient(
          rgba(0, 0, 0, 0.28),
          rgba(0, 0, 0, 0.28)
        ),
        url("https://i.ibb.co/YBgnyZKW/In-Shot-20260622-230134462.jpg");

      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
    }

    .home-background-hero .hero {
      height: 100%;
      min-height: 100%;
      box-sizing: border-box;
      display: flex;
      align-items: center;
    }

    /* Amit Dhakar */
    .home-name-yellow {
      color: #ffd900 !important;
      text-shadow:
        0 0 6px rgba(255, 255, 255, 0.25),
        0 0 12px rgba(255, 255, 255, 0.18);
    }

    /* 2. GitHub + LinkedIn
       Positioned below View Project / Contact */
    .home-social-links {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-sm);
      margin-top: var(--space-md);
      flex-wrap: wrap;
    }

    .home-social-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }

    /* SVG icon */
    .home-social-icon {
      width: 18px;
      height: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .home-social-icon svg {
      width: 18px;
      height: 18px;
      display: block;
    }

    /* Home sections */
    .home-section-copy {
      margin-top: var(--space-md);
    }

    /* Home contact links */
    .home-contact-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
      margin-top: var(--space-md);
    }

    .home-contact-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }

    @media (max-width: 600px) {
      .home-background-hero {
        aspect-ratio: 9 / 14;
        min-height: 0;
        max-height: none;
      }

      .home-social-links {
        justify-content: center;
      }
    }
  </style>
</head>

