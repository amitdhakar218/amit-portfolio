      justify-content: center;
      gap: 8px;
      min-height: 48px;
      text-decoration: none;
    }

    .home-social-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
      margin-top: var(--space-md);
    }

    .home-social-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }

    /* =========================================================
       VISITOR WELCOME MODAL
    ========================================================== */

    #visitor-modal {
      position: fixed;
      inset: 0;
      z-index: 10000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(0, 0, 0, 0.72);
      backdrop-filter: blur(8px);
    }

    #visitor-modal.show {
      display: flex;
    }

    .visitor-box {
      width: min(100%, 520px);
      max-height: calc(100vh - 40px);
      overflow-y: auto;
      padding: 26px;
      border-radius: 22px;
      background: var(--color-surface, #111827);
      border: 1px solid rgba(255,255,255,0.12);
      box-shadow: 0 25px 80px rgba(0,0,0,0.45);
    }

    .visitor-box h2 {
      margin-bottom: 8px;
    }

    .visitor-box p {
      margin-bottom: var(--space-md);
    }

    .visitor-actions {
      display: flex;
      gap: var(--space-sm);
      margin-top: var(--space-md);
    }

    .visitor-actions button {
      flex: 1;
    }

    #visitor-status {
      min-height: 1.4em;
      margin-top: 10px;
    }

    @media (max-width: 520px) {
      .visitor-box {
        padding: 20px;
      }

      .visitor-actions {
        flex-direction: column;
      }
    }
  </style>
