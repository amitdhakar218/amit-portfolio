  <script>
    document.addEventListener("DOMContentLoaded", async () => {

      /*
       * ========================================================
       * 1. VISITOR FORM
       * ========================================================
       *
       * First visit -> show form.
       * Confirm -> save to Firebase /visitors and remember.
       * Skip -> remember locally and continue.
       *
       * IMPORTANT:
       * We use the same Firebase "visitors" path that the
       * existing Contact page already uses.
       */

      const visitorModal =
        document.getElementById("visitor-modal");

      const visitorForm =
        document.getElementById("visitor-form");

      const visitorSkipBtn =
        document.getElementById("visitor-skip-btn");

      const visitorStatus =
        document.getElementById("visitor-status");

      const visitorConfirmBtn =
        document.getElementById("visitor-confirm-btn");


      function closeVisitorModal() {

        if (visitorModal) {
          visitorModal.classList.remove("show");
        }

      }


      function markVisitorHandled() {

        try {
          localStorage.setItem(
            "amit_portfolio_visitor_handled",
            "1"
          );
        } catch (err) {
          console.warn(
            "Could not save visitor state:",
            err
          );
        }

      }


      let visitorHandled = false;

      try {

        visitorHandled =
          localStorage.getItem(
            "amit_portfolio_visitor_handled"
          ) === "1";

      } catch (err) {

        visitorHandled = false;

      }


      /*
       * Show automatically for a new visitor.
       */
      if (!visitorHandled) {

        setTimeout(() => {

          if (visitorModal) {
            visitorModal.classList.add("show");
          }

        }, 350);

      }


      /*
       * Skip.
       */
      if (visitorSkipBtn) {

        visitorSkipBtn.addEventListener(
          "click",
          () => {

            markVisitorHandled();

            closeVisitorModal();

          }
        );

      }


      /*
       * Confirm visitor details.
       */
      if (visitorForm) {

        visitorForm.addEventListener(
          "submit",
          async (event) => {

            event.preventDefault();

            const name =
              document
                .getElementById("visitor-name")
                ?.value
                .trim() || "";

            const email =
              document
                .getElementById("visitor-email")
                ?.value
                .trim() || "";

            const phone =
              document
                .getElementById("visitor-phone")
                ?.value
                .trim() || "";

            const purpose =
              document
                .getElementById("visitor-purpose")
                ?.value
                .trim() || "";


            if (!name || !email) {

              visitorStatus.textContent =
                "Please enter your name and email.";

              return;

            }


            visitorStatus.textContent =
              "Saving your details...";

            visitorConfirmBtn.disabled = true;


            const visitorData = {

              name: name,

              email: email,

              phone: phone,

              purpose: purpose,

              page: "Portfolio Home",

              source: "portfolio",

              timestamp:
                new Date().toISOString(),

              userAgent:
                navigator.userAgent,

              language:
                navigator.language || "",

              referrer:
                document.referrer || "",

              path:
                window.location.pathname

            };


            try {

              if (
                typeof firebase !== "undefined" &&
                firebase.database
              ) {

                /*
                 * Same Firebase path used by Contact page:
                 * /visitors
                 */
                await firebase
                  .database()
                  .ref("visitors")
                  .push(visitorData);

              } else {

                throw new Error(
                  "Firebase Database is not available."
                );

              }


              /*
               * Save only after Firebase succeeds.
               * This prevents the form from disappearing when
               * the data was not actually saved.
               */
              markVisitorHandled();

              visitorStatus.textContent =
                "✅ Details saved. Welcome!";

              setTimeout(
                closeVisitorModal,
                500
              );


            } catch (error) {

              console.error(
                "Visitor save error:",
                error
              );

              visitorStatus.textContent =
                "❌ Could not save details. Please try again.";

              visitorConfirmBtn.disabled = false;

            }

          }
        );

      }


      /*
       * ========================================================
       * 2. HOME CONTACT / SOCIAL LINKS
       * ========================================================
       *
       * Try several common Firebase locations so existing
       * Studio data can be used without breaking the rest
       * of the portfolio.
       */

      const contactContainer =
        document.getElementById(
          "home-contact-links"
        );

      const socialContainer =
        document.getElementById(
          "home-social-links"
        );


      function escapeHtml(value) {

        return String(value ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");

      }


      function normaliseUrl(url) {

        if (!url) return "";

        let value =
          String(url).trim();

        if (!value) return "";

        if (
          value.startsWith("mailto:") ||
          value.startsWith("tel:") ||
          value.startsWith("https://") ||
          value.startsWith("http://")
        ) {

          return value;

        }

        return "https://" + value;

      }


      function socialIcon(label) {

        const text =
          String(label || "")
            .toLowerCase();

        if (text.includes("youtube")) {
          return "▶️";
        }

        if (
          text.includes("instagram")
        ) {
          return "📸";
        }

        if (
          text.includes("linkedin")
        ) {
          return "💼";
        }

        if (
          text.includes("github")
        ) {
          return "🐙";
        }

        if (
          text.includes("facebook")
        ) {
          return "📘";
        }

        if (
          text.includes("telegram")
        ) {
          return "✈️";
        }

        if (
          text.includes("whatsapp")
        ) {
          return "💬";
        }

        return "🔗";

      }


      function createSocialLink(
        label,
        url
      ) {

        const cleanUrl =
          normaliseUrl(url);

        if (!cleanUrl) return null;

        const link =
          document.createElement("a");

        link.className =
          "btn btn-outline home-social-link";

        link.href =
          cleanUrl;

        link.target =
          "_blank";

        link.rel =
          "noopener noreferrer";

        link.innerHTML =
          socialIcon(label) +
          " " +
          escapeHtml(
            label || "Link"
          );

        return link;

      }


      function addSocialItem(
        label,
        url
      ) {

        if (
          !socialContainer ||
          !url
        ) {
          return;
        }

        const link =
          createSocialLink(
            label,
            url
          );

        if (link) {
          socialContainer.appendChild(
            link
          );
        }

      }


      function processSocialObject(
        data
      ) {

        if (!data) return;


        /*
         * Array format:
         *
         * [
         *   {name:"YouTube", url:"..."},
         *   {name:"Instagram", url:"..."}
         * ]
         */
        if (Array.isArray(data)) {

          data.forEach(
            (item) => {

              if (!item) return;

              addSocialItem(
                item.name ||
                item.title ||
                item.label ||
                item.platform ||
                "Link",

                item.url ||
                item.link ||
                item.href
              );

            }
          );

          return;

        }


        /*
         * Object format:
         *
         * {
         *   youtube: "...",
         *   instagram: "..."
         * }
         */
        if (
          typeof data === "object"
        ) {

          Object.entries(data)
            .forEach(
              ([key, value]) => {

                if (
                  typeof value === "string"
                ) {

                  addSocialItem(
                    key,
                    value
                  );

                } else if (
                  value &&
                  typeof value === "object"
                ) {

                  addSocialItem(
                    value.name ||
                    value.title ||
                    value.label ||
                    key,

                    value.url ||
                    value.link ||
                    value.href
                  );

                }

              }
            );

        }

      }


      /*
       * Load contact information.
       */
      try {

        if (
          typeof firebase !== "undefined" &&
          firebase.database
        ) {

          const db =
            firebase.database();


          /*
           * Contact/settings candidates.
           */
          const paths = [
            "settings",
            "contact",
            "profile",
            "siteSettings"
          ];


          let combined = {};


          for (
            const path of paths
          ) {

            try {

              const snapshot =
                await db
                  .ref(path)
                  .once("value");

              const data =
                snapshot.val();

              if (
                data &&
                typeof data === "object"
              ) {

                combined = {
                  ...combined,
                  ...data
                };

              }

            } catch (err) {

              console.warn(
                "Could not read:",
                path,
                err
              );

            }

          }


          /*
           * Email.
           */
          const email =
            combined.email ||
            combined.contactEmail ||
            combined.emailAddress ||
            "";


          /*
           * Phone.
           */
          const phone =
            combined.phone ||
            combined.contactPhone ||
            combined.mobile ||
            "";


          /*
           * WhatsApp.
           */
          const whatsapp =
            combined.whatsapp ||
            combined.whatsApp ||
            combined.whatsappUrl ||
            "";


          if (
            contactContainer
          ) {

            /*
             * Remove the temporary Contact button.
             */
            contactContainer.innerHTML = "";


            if (email) {

              const emailLink =
                document.createElement("a");

              emailLink.className =
                "btn btn-outline home-contact-link";

              emailLink.href =
                "mailto:" + email;

              emailLink.innerHTML =
                "📧 Email";

              contactContainer.appendChild(
                emailLink
              );

            }


            if (phone) {

              const phoneLink =
                document.createElement("a");

              phoneLink.className =
                "btn btn-outline home-contact-link";

              phoneLink.href =
                "tel:" + phone;

              phoneLink.innerHTML =
                "📱 Call";

              contactContainer.appendChild(
                phoneLink
              );

            }


            if (whatsapp) {

              const waLink =
                document.createElement("a");

              waLink.className =
                "btn btn-primary home-contact-link";

              waLink.href =
                normaliseUrl(
                  whatsapp
                );

              waLink.target =
                "_blank";

              waLink.rel =
                "noopener noreferrer";

              waLink.innerHTML =
                "💬 WhatsApp";

              contactContainer.appendChild(
                waLink
              );

            }


            /*
             * If Studio has not supplied contact data,
             * keep the Contact Page button.
             */
            if (
              contactContainer.children.length === 0
            ) {

              const fallback =
                document.createElement("a");

              fallback.href =
                "contact.html";

              fallback.className =
                "btn btn-primary home-contact-link";

              fallback.innerHTML =
                "📩 Contact Me";

              contactContainer.appendChild(
                fallback
              );

            }

          }


          /*
           * Load all social-link structures that may exist
           * in the Studio database.
           */
          processSocialObject(
            combined.socialLinks
          );

          processSocialObject(
            combined.socials
          );

          processSocialObject(
            combined.social
          );

          processSocialObject(
            combined.links
          );


          /*
           * Also support direct fields.
           * These do not replace the Studio data; they are
           * additional compatible fields.
           */
          const directSocialFields = [
            ["YouTube", combined.youtube],
            ["YouTube", combined.youtubeUrl],
            ["Instagram", combined.instagram],
            ["Instagram", combined.instagramUrl],
            ["LinkedIn", combined.linkedin],
            ["LinkedIn", combined.linkedinUrl],
            ["GitHub", combined.github],
            ["GitHub", combined.githubUrl],
            ["Facebook", combined.facebook],
            ["Facebook", combined.facebookUrl],
            ["Telegram", combined.telegram],
            ["Telegram", combined.telegramUrl]
          ];


          directSocialFields.forEach(
            ([label, url]) => {

              if (url) {
                addSocialItem(
                  label,
                  url
                );
              }

            }
          );


          /*
           * If nothing was returned from Firebase, do not
           * leave an unexplained empty area.
           */
          if (
            socialContainer &&
            socialContainer.children.length === 0
          ) {

            socialContainer.innerHTML =
              '<a href="contact.html" class="btn btn-outline home-social-link">🔗 More Links</a>';

          }

        }

      } catch (error) {

        console.error(
          "Contact/social loading error:",
          error
        );

      }


      /*
       * ========================================================
       * 3. YEAR
       * ========================================================
       */

      const yearEl =
        document.getElementById(
          "current-year"
        );

      if (yearEl) {

        yearEl.textContent =
          new Date().getFullYear();

      }

    });
  </script>

</body>
</html>
