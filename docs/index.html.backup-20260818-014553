  <!-- =========================================================
       HOME ABOUT + CONTACT BRIDGE
       Keeps Home connected to the same Studio data.
  ========================================================== -->

  <script>
    document.addEventListener("DOMContentLoaded", () => {

      /* -------------------------------------------------------
         ABOUT
         Copy the existing About page data into Home.
      ------------------------------------------------------- */

      const aboutMap = {
        "about-intro": "home-about-content",
        "about-education": "home-about-education",
        "about-experience": "home-about-experience",
        "about-goals": "home-about-goals"
      };

      const syncAboutData = () => {

        Object.entries(aboutMap).forEach(([sourceId, targetId]) => {

          const source = document.getElementById(sourceId);
          const target = document.getElementById(targetId);

          if (source && target && source.textContent.trim()) {
            target.textContent = source.textContent;
          }

        });

      };

      /*
       * The About page IDs may not exist on Home, so use Firebase
       * directly as a fallback if common.js has already initialized it.
       */
      const loadHomeAbout = async () => {

        try {

          if (
            typeof firebase !== "undefined" &&
            firebase.database
          ) {

            const snapshot =
              await firebase.database().ref("about").once("value");

            const data = snapshot.val();

            if (data) {

              const intro =
                data.intro ||
                data.about ||
                data.description ||
                data.content ||
                "";

              const education =
                data.education ||
                "";

              const experience =
                data.experience ||
                "";

              const goals =
                data.goals ||
                "";

              const introEl =
                document.getElementById("home-about-content");

              const educationEl =
                document.getElementById("home-about-education");

              const experienceEl =
                document.getElementById("home-about-experience");

              const goalsEl =
                document.getElementById("home-about-goals");

              if (introEl && intro) {
                introEl.textContent = intro;
              }

              if (educationEl && education) {
                educationEl.textContent = education;
              }

              if (experienceEl && experience) {
                experienceEl.textContent = experience;
              }

              if (goalsEl && goals) {
                goalsEl.textContent = goals;
              }

            }

          }

        } catch (error) {

          console.warn(
            "Home About Firebase load:",
            error
          );

        }

      };


      /* -------------------------------------------------------
         CONTACT
         Use same social-link container used by contact.html.
      ------------------------------------------------------- */

      const syncContactLinks = () => {

        const sourceEmail =
          document.getElementById("contact-email");

        const sourcePhone =
          document.getElementById("contact-phone");

        const targetEmail =
          document.getElementById("home-contact-email");

        const targetPhone =
          document.getElementById("home-contact-phone");

        if (
          sourceEmail &&
          targetEmail &&
          sourceEmail.href
        ) {
          targetEmail.href = sourceEmail.href;
        }

        if (
          sourcePhone &&
          targetPhone &&
          sourcePhone.href
        ) {
          targetPhone.href = sourcePhone.href;
        }

      };


      /* -------------------------------------------------------
         CONTACT FORM
         Same Firebase visitors path used by contact.html.
      ------------------------------------------------------- */

      const contactForm =
        document.getElementById("contact-form");

      if (contactForm) {

        contactForm.addEventListener(
          "submit",
          async (event) => {

            event.preventDefault();

            const statusEl =
              document.getElementById(
                "contact-form-status"
              );

            const submitBtn =
              document.getElementById(
                "cf-submit-btn"
              );

            const email =
              document.getElementById(
                "cf-email"
              ).value.trim();

            const subject =
              document.getElementById(
                "cf-subject"
              ).value.trim();

            const message =
              document.getElementById(
                "cf-message"
              ).value.trim();


            if (!email || !message) {
              return;
            }


            statusEl.textContent =
              "Sending...";

            submitBtn.disabled = true;


            try {

              if (
                typeof firebase === "undefined" ||
                !firebase.database
              ) {
                throw new Error(
                  "Firebase is not available."
                );
              }


              await firebase
                .database()
                .ref("visitors")
                .push({

                  email: email,

                  subject: subject,

                  message: message,

                  page: "home",

                  timestamp:
                    new Date().toISOString()

                });


              statusEl.textContent =
                "✅ Sent! I'll get back to you soon.";

              contactForm.reset();


            } catch (error) {

              console.error(
                "Home contact error:",
                error
              );

              statusEl.textContent =
                "❌ " + error.message;


            } finally {

              submitBtn.disabled = false;

            }

          }
        );

      }


      /* -------------------------------------------------------
         RUN
      ------------------------------------------------------- */

      loadHomeAbout();

      syncAboutData();

      syncContactLinks();

      setTimeout(syncAboutData, 800);

      setTimeout(syncContactLinks, 800);

      setTimeout(syncAboutData, 1800);

      setTimeout(syncContactLinks, 1800);

    });
  </script>

