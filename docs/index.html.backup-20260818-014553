    /* Hero background image */
    #home.hero {
      position: relative;
      min-height: 720px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;

      background-image:
        linear-gradient(
          rgba(0, 0, 0, 0.78),
          rgba(0, 0, 0, 0.78)
        ),
        url("https://i.ibb.co/YBgnyZKW/In-Shot-20260622-230134462.jpg");

      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
    }

    #home.hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          180deg,
          rgba(0, 0, 0, 0.28) 0%,
          rgba(0, 0, 0, 0.72) 72%,
          rgba(0, 0, 0, 0.90) 100%
        );
      pointer-events: none;
      z-index: 0;
    }

    #home .hero-content {
      position: relative;
      z-index: 2;
      text-align: center;
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
    }

    /* Amit Dhakar — border + shadow glow */
    #home .hero-title {
      color: #ffffff;

      -webkit-text-stroke: 1.2px rgba(255, 255, 255, 0.72);

      text-shadow:
        0 0 2px rgba(255, 255, 255, 0.95),
        0 0 8px rgba(255, 255, 255, 0.65),
        0 0 18px rgba(0, 170, 255, 0.32),
        0 5px 20px rgba(0, 0, 0, 0.95);
    }

    /* Home contact */
    #contact .contact-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
      align-items: center;
    }

    #contact .contact-links .btn {
      text-decoration: none;
    }

    #contact .contact-social-links {
      display: contents;
    }

    /* Keep social links visually consistent */
    #contact-social-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    /* Small screens */
    @media (max-width: 600px) {
      #home.hero {
        min-height: 680px;
        background-position: center center;
      }

      #home .hero-title {
        -webkit-text-stroke: 0.9px rgba(255, 255, 255, 0.72);
        text-shadow:
          0 0 2px rgba(255, 255, 255, 0.9),
          0 0 7px rgba(255, 255, 255, 0.55),
          0 0 14px rgba(0, 170, 255, 0.28),
          0 4px 14px rgba(0, 0, 0, 0.95);
