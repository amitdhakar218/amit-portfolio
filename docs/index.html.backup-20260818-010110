  <script>

    document.addEventListener(
      "DOMContentLoaded",
      async () => {

        /* =====================================================
           BASIC
        ====================================================== */

        const yearEl =
          document.getElementById(
            "current-year"
          );

        if (yearEl) {
          yearEl.textContent =
            new Date().getFullYear();
        }


        /* =====================================================
           VISITOR MODAL
        ====================================================== */

        const visitorOverlay =
          document.getElementById(
            "visitor-modal-overlay"
          );

        const visitorForm =
          document.getElementById(
            "visitor-form"
          );

        const visitorSkip =
          document.getElementById(
            "visitor-skip-btn"
          );

        const visitorConfirm =
          document.getElementById(
            "visitor-confirm-btn"
          );

        const visitorStatus =
          document.getElementById(
            "visitor-status"
          );

        const visitorStorageKey =
          "amit_portfolio_visitor_completed";


        function closeVisitorModal() {

          if (!visitorOverlay) {
            return;
          }

          visitorOverlay.style.display =
            "none";

          visitorOverlay.setAttribute(
            "aria-hidden",
            "true"
          );

        }


        function openVisitorModal() {

          if (!visitorOverlay) {
            return;
          }

          visitorOverlay.style.display =
            "flex";

          visitorOverlay.setAttribute(
            "aria-hidden",
            "false"
          );

        }


        /*
         * New browser:
         * show visitor form.
         */

        if (
          !localStorage.getItem(
            visitorStorageKey
          )
        ) {

          setTimeout(
            openVisitorModal,
            600
          );

        }


        /*
         * Skip
         */

        if (visitorSkip) {

          visitorSkip.addEventListener(
            "click",
            () => {

              localStorage.setItem(
                visitorStorageKey,
                "skipped"
              );

              closeVisitorModal();

            }
          );

        }


        /* =====================================================
           FIREBASE READY
        ====================================================== */

        async function waitForFirebase(
          timeout = 15000
        ) {

          const start =
            Date.now();

          while (
            Date.now() - start <
            timeout
          ) {

            try {

              if (
                typeof firebase !==
                  "undefined" &&
                firebase.database &&
                firebase.apps &&
                firebase.apps.length > 0
              ) {

                return true;

              }

            } catch (error) {

              console.warn(
                "Firebase check:",
                error
              );

            }

            await new Promise(
              resolve =>
                setTimeout(
                  resolve,
                  150
                )
            );

          }

          return false;

        }


        /* =====================================================
           SAVE VISITOR
        ====================================================== */

        if (visitorForm) {

          visitorForm.addEventListener(
            "submit",
            async event => {

              event.preventDefault();


              const name =
                document
                  .getElementById(
                    "visitor-name"
                  )
                  ?.value
                  .trim() || "";


              const email =
                document
                  .getElementById(
                    "visitor-email"
                  )
                  ?.value
                  .trim() || "";


              const phone =
                document
                  .getElementById(
                    "visitor-phone"
                  )
                  ?.value
                  .trim() || "";


              const purpose =
                document
                  .getElementById(
                    "visitor-purpose"
                  )
                  ?.value
                  .trim() || "";


              /*
               * At least one identity field.
               */

              if (
                !name &&
                !email
              ) {

                visitorStatus.textContent =
                  "Please enter your name or email.";

                visitorStatus.classList.add(
                  "visitor-error"
                );

                return;

              }


              visitorStatus.classList.remove(
                "visitor-error",
                "visitor-success"
              );


              visitorStatus.textContent =
                "Connecting to Firebase...";


              visitorConfirm.disabled =
                true;


              try {

                const firebaseReady =
                  await waitForFirebase();


                if (!firebaseReady) {

                  throw new Error(
                    "Firebase is not initialized. Please check common.js Firebase configuration."
                  );

                }


                /*
                 * Same Firebase path used by
                 * the existing Contact page:
                 *
                 * visitors
                 */

                const visitorRef =
                  firebase
                    .database()
                    .ref("visitors")
                    .push();


                const visitorData = {

                  name:
                    name,

                  email:
                    email,

                  phone:
                    phone,

                  purpose:
                    purpose,

                  subject:
                    "Portfolio Visitor",

                  message:
                    purpose ||
                    "Visitor submitted portfolio details.",

                  type:
                    "portfolio_visitor",

                  source:
                    "portfolio_home_welcome_form",

                  page:
                    window.location.pathname,

                  pageUrl:
                    window.location.href,

                  timestamp:
                    new Date().toISOString(),

                  createdAt:
                    Date.now(),

                  userAgent:
                    navigator.userAgent || "",

                  language:
                    navigator.language || "",

                  referrer:
                    document.referrer || "",

                  status:
                    "new"

                };


                /*
                 * IMPORTANT:
                 * await guarantees Firebase accepted
                 * the write before we tell visitor success.
                 */

                await visitorRef.set(
                  visitorData
                );


                console.log(
                  "✅ VISITOR SAVED TO FIREBASE",
                  {
                    firebaseKey:
                      visitorRef.key,

                    path:
                      "visitors/" +
                      visitorRef.key,

                    data:
                      visitorData
                  }
                );


                visitorStatus.textContent =
                  "✅ Details saved successfully. Welcome!";

                visitorStatus.classList.add(
                  "visitor-success"
                );


                localStorage.setItem(
                  visitorStorageKey,
                  "confirmed"
                );


                setTimeout(
                  closeVisitorModal,
                  700
                );


              } catch (error) {

                console.error(
                  "❌ VISITOR FIREBASE SAVE ERROR:",
                  error
                );


                visitorStatus.textContent =
                  "❌ Details could not be saved. Please try again.";

                visitorStatus.classList.add(
                  "visitor-error"
                );


                /*
                 * Do NOT mark visitor as completed
                 * when Firebase failed.
                 */

              } finally {

                visitorConfirm.disabled =
                  false;

              }

            }
          );

        }


        /* =====================================================
           SOCIAL LINK HELPERS
        ====================================================== */

        const SOCIAL_CONFIG = {

          github: {
            label: "Github",
            icon: "fa-brands fa-github",
            order: 1
          },

          linkedin: {
            label: "LinkedIn",
            icon: "fa-brands fa-linkedin",
            order: 2
          },

          youtube: {
            label: "YouTube",
            icon: "fa-brands fa-youtube",
            order: 3
          },

          youtube1: {
            label: "YouTube",
            icon: "fa-brands fa-youtube",
            order: 4
          },

          youtube2: {
            label: "YouTube",
            icon: "fa-brands fa-youtube",
            order: 5
          },

          instagram: {
            label: "Instagram",
            icon: "fa-brands fa-instagram",
            order: 6
          },

          facebook: {
            label: "Facebook",
            icon: "fa-brands fa-facebook",
            order: 7
          },

          twitter: {
            label: "Twitter",
            icon: "fa-brands fa-x-twitter",
            order: 8
          },

          x: {
            label: "X",
            icon: "fa-brands fa-x-twitter",
            order: 9
          },

          telegram: {
            label: "Telegram",
            icon: "fa-brands fa-telegram",
            order: 10
          },

          whatsapp: {
            label: "WhatsApp",
            icon: "fa-brands fa-whatsapp",
            order: 11
          },

          website: {
            label: "Website",
            icon: "fa-solid fa-globe",
            order: 12
          },

          portfolio: {
            label: "Portfolio",
            icon: "fa-solid fa-globe",
            order: 13
          }

        };


        function normalizeUrl(
          value
        ) {

          if (
            typeof value !==
            "string"
          ) {

            return "";

          }

          const url =
            value.trim();

          if (!url) {
            return "";
          }

          /*
           * Only allow normal web links.
           */

          if (
            /^https?:\/\//i.test(
              url
            )
          ) {

            return url;

          }

          /*
           * Convert common social URLs
           * if Studio stores them without protocol.
           */

          if (
            /^(www\.)/i.test(
              url
            )
          ) {

            return "https://" + url;

          }

          return "";

        }


        function collectSocialLinks(
          object,
          result = [],
          path = ""
        ) {

          if (
            !object ||
            typeof object !==
              "object"
          ) {

            return result;

          }


          Object.entries(
            object
          ).forEach(
            ([key, value]) => {

              const normalizedKey =
                String(key)
                  .toLowerCase()
                  .replace(
                    /[^a-z0-9]/g,
                    ""
                  );


              /*
               * Direct social field.
               */

              if (
                typeof value ===
                  "string" &&
                SOCIAL_CONFIG[
                  normalizedKey
                ]
              ) {

                const url =
                  normalizeUrl(
                    value
                  );

                if (url) {

                  result.push({
                    key:
                      normalizedKey,

                    url:
                      url,

                    label:
                      SOCIAL_CONFIG[
                        normalizedKey
                      ].label,

                    icon:
                      SOCIAL_CONFIG[
                        normalizedKey
                      ].icon,

                    order:
                      SOCIAL_CONFIG[
                        normalizedKey
                      ].order,

                    path:
                      path +
                      key
                  });

                }

                return;

              }


              /*
               * Support arrays of social links:
               *
               * [
               *   {
               *      name:"Instagram",
               *      url:"..."
               *   }
               * ]
               */

              if (
                Array.isArray(
                  value
                )
              ) {

                value.forEach(
                  item => {

                    if (
                      !item ||
                      typeof item !==
                        "object"
                    ) {

                      return;

                    }

                    const name =
                      String(
                        item.name ||
                        item.title ||
                        item.platform ||
                        item.type ||
                        ""
                      )
                        .toLowerCase()
                        .replace(
                          /[^a-z0-9]/g,
                          ""
                        );


                    const url =
                      normalizeUrl(
                        item.url ||
                        item.link ||
                        item.href ||
                        ""
                      );


                    if (
                      url &&
                      SOCIAL_CONFIG[name]
                    ) {

                      result.push({

                        key:
                          name,

                        url:
                          url,

                        label:
                          SOCIAL_CONFIG[
                            name
                          ].label,

                        icon:
                          SOCIAL_CONFIG[
                            name
                          ].icon,

                        order:
                          SOCIAL_CONFIG[
                            name
                          ].order,

                        path:
                          path +
                          key

                      });

                    }

                  }
                );

                return;

              }


              /*
               * Recursively search Studio profile object.
               */

              if (
                value &&
                typeof value ===
                  "object"
              ) {

                collectSocialLinks(
                  value,
                  result,
                  path +
                    key +
                    "."
                );

              }

            }
          );


          return result;

        }


        function uniqueSocialLinks(
          links
        ) {

          const map =
            new Map();


          links.forEach(
            link => {

              const id =
                link.url;

              if (
                !map.has(id)
              ) {

                map.set(
                  id,
                  link
                );

              }

            }
          );


          return Array
            .from(
              map.values()
            )
            .sort(
              (a,b) =>
                (a.order || 99) -
                (b.order || 99)
            );

        }


        function createSocialButton(
          link,
          className = ""
        ) {

          const a =
            document.createElement(
              "a"
            );


          a.href =
            link.url;

          a.target =
            "_blank";

          a.rel =
            "noopener noreferrer";

          a.className =
            "btn btn-outline " +
            className;


          const icon =
            document.createElement(
              "i"
            );

          icon.className =
            link.icon ||
            "fa-solid fa-link";


          const span =
            document.createElement(
              "span"
            );

          span.textContent =
            link.label;


          a.appendChild(
            icon
          );

          a.appendChild(
            span
          );


          return a;

        }


        /* =====================================================
           LOAD SOCIAL LINKS FROM STUDIO / FIREBASE
        ====================================================== */

        async function loadSocialLinks() {

          const homeSocial =
            document.getElementById(
              "home-social-links"
            );

          const contactSocial =
            document.getElementById(
              "contact-social-links"
            );

          const loading =
            document.getElementById(
              "social-loading"
            );


          const links = [];


          /*
           * 1. First use any links exposed by common.js.
           */

          if (
            window.portfolioSocials
          ) {

            collectSocialLinks(
              window.portfolioSocials,
              links
            );

          }


          /*
           * 2. Read Studio profile.
           */

          try {

            const firebaseReady =
              await waitForFirebase(
                10000
              );


            if (
              firebaseReady
            ) {

              /*
               * Possible Studio locations.
               *
               * We read them one by one.
               */

              const paths = [
                "profile",
                "socials",
                "social",
                "settings",
                "contact"
              ];


              for (
                const firebasePath
                of paths
              ) {

                try {

                  const snapshot =
                    await firebase
                      .database()
                      .ref(
                        firebasePath
                      )
                      .once(
                        "value"
                      );


                  const data =
                    snapshot.val();


                  if (data) {

                    collectSocialLinks(
                      data,
                      links,
                      firebasePath +
                        "."
                    );

                  }

                } catch (
                  pathError
                ) {

                  console.warn(
                    "Social path unavailable:",
                    firebasePath,
                    pathError
                  );

                }

              }

            }

          } catch (error) {

            console.warn(
              "Could not load Studio social links:",
              error
            );

          }


          /*
           * 3. Built-in fallback links.
           *
           * These only appear if Studio does not provide
           * that particular link.
           */

          const fallbackLinks = [

            {
              key: "github",
              label: "Github",
              icon: "fa-brands fa-github",
              url:
                "https://github.com/amitdhakar218",
              order: 1
            },

            {
              key: "linkedin",
              label: "LinkedIn",
              icon: "fa-brands fa-linkedin",
              url:
                "https://www.linkedin.com/in/amit-dhakar-564177385",
              order: 2
            }

          ];


          fallbackLinks.forEach(
            fallback => {

              const alreadyExists =
                links.some(
                  link =>
                    link.key ===
                    fallback.key
                );


              if (
                !alreadyExists
              ) {

                links.push(
                  fallback
                );

              }

            }
          );


          const finalLinks =
            uniqueSocialLinks(
              links
            );


          /*
           * Clear loading.
           */

          if (
            loading
          ) {

            loading.remove();

          }


          /*
           * Home social links.
           */

          if (
            homeSocial
          ) {

            homeSocial.innerHTML =
              "";

            finalLinks.forEach(
              link => {

                homeSocial.appendChild(
                  createSocialButton(
                    link,
                    "home-social-link"
                  )
                );

              }
            );

          }


          /*
           * Contact social links.
           */

          if (
            contactSocial
          ) {

            contactSocial.innerHTML =
              "";

            finalLinks.forEach(
              link => {

                contactSocial.appendChild(
                  createSocialButton(
                    link,
                    "contact-social-link"
                  )
                );

              }
            );

          }


          console.log(
            "✅ SOCIAL LINKS LOADED:",
            finalLinks
          );

        }


        loadSocialLinks();


        /* =====================================================
           HERO IMAGE ERROR DEBUG
        ====================================================== */

        const hero =
          document.querySelector(
            ".home-hero"
          );


        /*
         * Browser does not expose CSS background loading
         * directly, so create a test image.
         */

        const heroImage =
          new Image();


        heroImage.onload =
          () => {

            console.log(
              "✅ HERO BACKGROUND IMAGE LOADED:",
              "https://i.ibb.co/YBgnyZKW/In-Shot-20260622-230134462.jpg"
            );

          };


        heroImage.onerror =
          () => {

            console.error(
              "❌ HERO BACKGROUND IMAGE COULD NOT LOAD:",
              "https://i.ibb.co/YBgnyZKW/In-Shot-20260622-230134462.jpg"
            );

          };


        heroImage.src =
          "https://i.ibb.co/YBgnyZKW/In-Shot-20260622-230134462.jpg";


        /* =====================================================
           TEST HELPERS
        ====================================================== */

        window.resetVisitorForm =
          function () {

            localStorage.removeItem(
              "amit_portfolio_visitor_completed"
            );

            location.reload();

          };


        window.testFirebaseVisitors =
          async function () {

            try {

              const ready =
                await waitForFirebase(
                  10000
                );


              if (!ready) {

                console.error(
                  "❌ Firebase not ready"
                );

                return;

              }


              const snapshot =
                await firebase
                  .database()
                  .ref("visitors")
                  .limitToLast(5)
                  .once("value");


              console.log(
                "✅ LAST FIREBASE VISITORS:",
                snapshot.val()
              );


            } catch (
              error
            ) {

              console.error(
                "❌ Could not read visitors:",
                error
              );

            }

          };


        console.log(
          "Amit Portfolio Home loaded."
        );

        console.log(
          "Visitor reset:",
          "resetVisitorForm()"
        );

        console.log(
          "Test Firebase visitors:",
          "testFirebaseVisitors()"
        );

      }
    );

  </script>

