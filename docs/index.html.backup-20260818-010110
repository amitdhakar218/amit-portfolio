    /* =========================================================
       HOME HERO
    ========================================================== */

    .home-hero {
      position: relative;
      min-height: 720px;

      display: flex;
      align-items: center;
      justify-content: center;

      overflow: hidden;

      background-image:
        linear-gradient(
          90deg,
          rgba(0,0,0,0.88) 0%,
          rgba(0,0,0,0.72) 42%,
          rgba(0,0,0,0.58) 100%
        ),
        url("https://i.ibb.co/YBgnyZKW/In-Shot-20260622-230134462.jpg");

      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    .home-hero::after {
      content: "";
      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          to bottom,
          rgba(0,0,0,0.15),
          rgba(0,0,0,0.70)
        );

      pointer-events: none;
    }

    .home-hero-content {
      position: relative;
      z-index: 2;

      width: min(950px, 94%);

      text-align: center;

      padding:
        var(--space-xl)
        var(--space-md);
    }

    .home-hero-title {
      font-size:
        clamp(2.2rem, 8vw, 4.8rem);

      line-height: 1.05;

      margin:
        0 0
        var(--space-md);
    }

    .home-hero-subtitle {
      font-size:
        clamp(0.95rem, 2.8vw, 1.2rem);

      color: var(--color-muted);

      max-width: 750px;

      margin:
        0 auto
        var(--space-lg);
    }

    /* =========================================================
       SOCIAL LINKS
    ========================================================== */

    .home-social-links {
      display: flex;

      flex-wrap: wrap;

      justify-content: center;

      align-items: center;

      gap: 8px;

      margin-top: var(--space-md);
    }

    .home-social-link {
      display: inline-flex;

      align-items: center;
      justify-content: center;

      gap: 8px;

      min-width: 105px;

      text-decoration: none;

      white-space: nowrap;
    }

    .home-social-link i {
      font-size: 16px;
    }

    .home-social-link span {
      font-size: 0.85rem;
    }

    /* =========================================================
       VISITOR MODAL
    ========================================================== */

    #visitor-modal-overlay {
      position: fixed;

      inset: 0;

      z-index: 10000;

      display: flex;

      align-items: center;
      justify-content: center;

      padding: var(--space-md);

      background:
        rgba(0,0,0,0.84);

      backdrop-filter:
        blur(9px);
    }

    #visitor-modal {
      width: min(520px, 100%);

      max-height: 92vh;

      overflow-y: auto;

      padding: var(--space-lg);

      border-radius: var(--radius-lg);

      border:
        1px solid
        rgba(255,255,255,0.10);

      background:
        rgba(18,18,18,0.98);

      box-shadow:
        0 25px 80px
        rgba(0,0,0,0.60);
    }

    .visitor-logo {
      width: 62px;
      height: 62px;

      display: block;

      margin:
        0 auto
        var(--space-md);

      object-fit: contain;
    }

    .visitor-title {
      text-align: center;

      margin-bottom:
        var(--space-xs);
    }

    .visitor-subtitle {
      text-align: center;

      color: var(--color-muted);

      font-size: 0.9rem;

      margin-bottom:
        var(--space-lg);
    }

    .visitor-actions {
      display: flex;

      gap: var(--space-sm);

      margin-top:
        var(--space-md);
    }

    .visitor-actions .btn {
      flex: 1;
    }

    .visitor-status {
      min-height: 1.4em;

      margin-top:
        var(--space-sm);

      text-align: center;

      font-size: 0.85rem;
    }

    .visitor-error {
      color: #ef4444 !important;
    }

    .visitor-success {
      color: #22c55e !important;
    }

    /* =========================================================
       CONTACT SOCIAL LINKS
    ========================================================== */

    #contact-social-links {
      display: flex;

      flex-wrap: wrap;

      gap: 8px;

      margin-top: 8px;
    }

    .contact-social-link {
      display: inline-flex;

      align-items: center;
      justify-content: center;

      gap: 7px;
    }

    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @media (max-width: 600px) {

      .home-hero {
        min-height: 650px;

        background-position:
          62% center;
      }

      .visitor-actions {
        flex-direction: column;
      }

      .home-social-link {
        min-width: 95px;
      }
    }

