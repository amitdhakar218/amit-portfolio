  <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>

  <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>


  <!-- =========================================================
       COMMON JS
  ========================================================== -->

  <script src="js/common.js"></script>


  <!-- =========================================================
       PAGE MODULES
  ========================================================== -->

  <script src="js/projects-page.js"></script>

  <script src="js/skills-page.js"></script>

  <script src="js/certificates-page.js"></script>

  <script src="js/gallery-page.js"></script>

  <script src="js/videos-page.js"></script>

  <script src="js/blog-page.js"></script>

</body>
</html>
