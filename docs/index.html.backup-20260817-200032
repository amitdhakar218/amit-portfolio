  <script>
    document.addEventListener("DOMContentLoaded", () => {

      /*
       * ========================================================
       * VISITOR WELCOME FORM
       * ========================================================
       */

      const visitorOverlay =
        document.getElementById("visitor-modal-overlay");

      const visitorForm =
        document.getElementById("visitor-form");

      const visitorSkipBtn =
        document.getElementById("visitor-skip-btn");

      const visitorStatus =
        document.getElementById("visitor-status");

      const visitorConfirmBtn =
        document.getElementById("visitor-confirm-btn");

      const visitorCompletedKey =
        "amit_portfolio_visitor_completed";

      function closeVisitorModal() {
        if (!visitorOverlay) return;

        visitorOverlay.style.display = "none";
        visitorOverlay.setAttribute(
          "aria-hidden",
          "true"
        );
      }

      function showVisitorModal() {
        if (!visitorOverlay) return;

        visitorOverlay.style.display = "flex";
        visitorOverlay.setAttribute(
          "aria-hidden",
          "false"
        );
      }

      /*
       * Show for a new browser visitor.
       *
       * For testing, use:
       * localStorage.removeItem("amit_portfolio_visitor_completed")
       */

      if (
        visitorOverlay &&
        !localStorage.getItem(visitorCompletedKey)
      ) {
        setTimeout(() => {
          showVisitorModal();
        }, 700);
      }

      if (visitorSkipBtn) {
        visitorSkipBtn.addEventListener("click", () => {

          localStorage.setItem(
            visitorCompletedKey,
            "skipped"
          );

          closeVisitorModal();
        });
      }

      if (visitorForm) {

        visitorForm.addEventListener(
          "submit",
          async (event) => {

            event.preventDefault();

            const name =
              document.getElementById(
                "visitor-name"
              )?.value.trim() || "";

            const email =
              document.getElementById(
                "visitor-email"
              )?.value.trim() || "";

            const phone =
              document.getElementById(
                "visitor-phone"
              )?.value.trim() || "";

            const purpose =
              document.getElementById(
                "visitor-purpose"
              )?.value.trim() || "";

            if (!name && !email) {

              if (visitorStatus) {
                visitorStatus.textContent =
                  "Please enter at least your name or email.";
              }

              return;
            }

            if (visitorStatus) {
              visitorStatus.textContent =
                "Saving your details...";
            }

            if (visitorConfirmBtn) {
              visitorConfirmBtn.disabled = true;
            }

            const visitorData = {
              name: name,
              email: email,
              phone: phone,
              purpose: purpose,
              page: "portfolio-home",
              source: "visitor-welcome-form",
              timestamp: new Date().toISOString(),
              userAgent: navigator.userAgent
            };

            try {

              /*
               * common.js normally initializes Firebase.
               * We only push if Firebase is available.
               */

              if (
                typeof firebase !== "undefined" &&
                firebase.database
              ) {

                await firebase
                  .database()
                  .ref("visitors")
                  .push(visitorData);

              }

              localStorage.setItem(
                visitorCompletedKey,
                "confirmed"
              );

              if (visitorStatus) {
                visitorStatus.textContent =
                  "✅ Thank you! Welcome to my portfolio.";
              }

              setTimeout(() => {
                closeVisitorModal();
              }, 500);

            } catch (error) {

              console.error(
                "Visitor save error:",
                error
              );

              /*
               * Even if Firebase is temporarily unavailable,
               * don't block the visitor.
               */

              localStorage.setItem(
                visitorCompletedKey,
                "confirmed"
              );

              closeVisitorModal();

            } finally {

              if (visitorConfirmBtn) {
                visitorConfirmBtn.disabled = false;
              }

            }

          }
        );
      }


      /*
       * ========================================================
       * SOCIAL LINKS
       *
       * These can be populated by common.js / Studio data.
       * We don't force fake URLs here.
       * ========================================================
       */

      const youtube1 =
        document.getElementById("home-youtube-1");

      const youtube2 =
        document.getElementById("home-youtube-2");

      const instagram =
        document.getElementById("home-instagram");

      /*
       * If common.js / Studio puts social URLs on window,
       * use them.
       */

      if (
        window.portfolioSocials &&
        typeof window.portfolioSocials === "object"
      ) {

        const socials =
          window.portfolioSocials;

        if (socials.youtube) {
          if (youtube1) {
            youtube1.href = socials.youtube;
          }

          if (youtube2) {
            youtube2.href = socials.youtube;
          }
        }

        if (socials.instagram && instagram) {
          instagram.href = socials.instagram;
        }

      }


      /*
       * ========================================================
       * HOME CONTACT
       *
       * Keep same IDs as contact.html so common.js can populate
       * Email / Phone / Social information.
       * ========================================================
       */


      /*
       * ========================================================
       * TESTING HELPER
       * ========================================================
       *
       * In browser console:
       *
       * localStorage.removeItem(
       *   "amit_portfolio_visitor_completed"
       * );
       *
       * Then refresh.
       */

    });
  </script>

</body>
