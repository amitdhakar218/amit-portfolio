  <style>
    /* =========================================================
       HOME HERO BACKGROUND
    ========================================================== */

    .home-hero {
      position: relative;
      min-height: 720px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;

      background:
        linear-gradient(
          90deg,
          rgba(0, 0, 0, 0.88) 0%,
          rgba(0, 0, 0, 0.72) 42%,
          rgba(0, 0, 0, 0.58) 100%
        ),
        url("assets/profile.jpg");

      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    .home-hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.25),
          rgba(0, 0, 0, 0.68)
        );
      pointer-events: none;
    }

    .home-hero-content {
      position: relative;
      z-index: 2;
      width: min(900px, 94%);
      text-align: center;
      padding: var(--space-xl) var(--space-md);
    }

    .home-hero-title {
      font-size: clamp(2.2rem, 8vw, 4.8rem);
      line-height: 1.05;
      margin: 0 0 var(--space-md);
    }

    .home-hero-subtitle {
      font-size: clamp(0.95rem, 2.8vw, 1.2rem);
      color: var(--color-muted);
      max-width: 700px;
      margin: 0 auto var(--space-lg);
    }

    .home-social-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-xs);
      margin-top: var(--space-md);
    }

    .home-social-links .btn {
      min-width: 100px;
    }

    /* =========================================================
       VISITOR WELCOME MODAL
    ========================================================== */

    #visitor-modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 10000;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: var(--space-md);

      background: rgba(0, 0, 0, 0.82);
      backdrop-filter: blur(8px);
    }

    #visitor-modal {
      width: min(520px, 100%);
      max-height: 92vh;
      overflow-y: auto;

      border: 1px solid rgba(255, 255, 255, 0.10);
      border-radius: var(--radius-lg);

      background: rgba(18, 18, 18, 0.97);

      box-shadow:
        0 25px 80px rgba(0, 0, 0, 0.55);

      padding: var(--space-lg);
    }

    .visitor-logo {
      width: 62px;
      height: 62px;
      margin: 0 auto var(--space-md);
      display: block;
      object-fit: contain;
    }

    .visitor-title {
      text-align: center;
      margin-bottom: var(--space-xs);
    }

    .visitor-subtitle {
      text-align: center;
      color: var(--color-muted);
      font-size: 0.9rem;
      margin-bottom: var(--space-lg);
    }

    .visitor-actions {
      display: flex;
      gap: var(--space-sm);
      margin-top: var(--space-md);
    }

    .visitor-actions .btn {
      flex: 1;
    }

    .visitor-status {
      min-height: 1.3em;
      margin-top: var(--space-sm);
      text-align: center;
      font-size: 0.85rem;
    }

    @media (max-width: 600px) {
      .home-hero {
        min-height: 620px;
        background-position: 62% center;
      }

      .visitor-actions {
        flex-direction: column;
      }
    }
  </style>
</head>

