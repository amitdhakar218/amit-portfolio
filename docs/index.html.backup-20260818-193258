  <!-- =========================================================
       FEEDBACK
  ========================================================== -->

  <section class="section" id="feedback">

    <h2 class="section-title">
      Feedback
    </h2>

    <div class="card">

      <p class="card-body">
        Your feedback helps improve this portfolio.
      </p>

      <button
        type="button"
        id="feedback-fab"
        class="btn btn-primary"
        style="margin-top:var(--space-md);"
      >
        💬 Leave Feedback
      </button>

    </div>

  </section>


  <!-- =========================================================
       FEEDBACK MODAL
  ========================================================== -->

  <div
    class="modal-overlay"
    id="feedback-modal-overlay"
    style="display:none;"
  >

    <div class="card modal-box">

      <h3 class="card-title">
        💬 Leave Feedback
      </h3>

      <p
        id="feedback-status"
        class="text-muted"
        style="min-height:1.2em; margin-bottom:var(--space-sm);"
      ></p>

      <form id="feedback-form">

        <div
          class="form-grid"
          style="grid-template-columns:1fr;"
        >

          <label class="form-field">

            <span>
              Your Name (optional)
            </span>

            <input
              type="text"
              id="fb-name"
            />

          </label>

          <label class="form-field">

            <span>
              Your Feedback
            </span>

            <textarea
              id="fb-message"
              rows="4"
              required
            ></textarea>

          </label>

        </div>

        <div
          class="hero-buttons"
          style="margin-top:var(--space-md);"
        >

          <button
            type="submit"
            class="btn btn-primary"
            style="flex:1;"
          >
            Send
          </button>

          <button
            type="button"
            class="btn btn-outline"
            id="feedback-close-btn"
            style="flex:1;"
          >
            Close
          </button>

        </div>

      </form>

    </div>

  </div>


  <!-- =========================================================
       FOOTER
  ========================================================== -->

