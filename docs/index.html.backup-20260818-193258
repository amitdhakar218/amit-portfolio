    name="description"
    content="Amit Dhakar — Electronics & Communication student, developer and technology enthusiast."
  />

  <link rel="stylesheet" href="shared/css/design-system.css" />
  <link rel="stylesheet" href="shared/css/components.css" />
  <link rel="stylesheet" href="css/style.css" />

  <style>
    /* =========================================================
       ONLY REQUESTED HOME PAGE CHANGES
    ========================================================== */

    /* Background image: 9:14, dark, ends before About */
    .home-background-hero {
      position: relative;
      width: 100%;
      aspect-ratio: 9 / 14;
      min-height: 520px;
      max-height: 900px;
      overflow: hidden;

      background-image:
        linear-gradient(
          rgba(0, 0, 0, 0.48),
          rgba(0, 0, 0, 0.48)
        ),
        url("https://i.ibb.co/YBgnyZKW/In-Shot-20260622-230134462.jpg");

      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
    }

    .home-background-hero .hero {
      height: 100%;
      min-height: 100%;
      box-sizing: border-box;
      display: flex;
      align-items: center;
    }

    /* Amit Dhakar yellow */
    .home-name-yellow {
      color: #ffd900 !important;
      text-shadow:
        0 0 6px rgba(255, 255, 255, 0.25),
        0 0 12px rgba(255, 255, 255, 0.18);
    }

    /* Only GitHub + LinkedIn */
    .home-social-links {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      margin-top: var(--space-md);
      flex-wrap: wrap;
    }

    .home-social-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }

    /* Home sections */
    .home-section-copy {
      margin-top: var(--space-md);
    }

    @media (max-width: 600px) {
      .home-background-hero {
        aspect-ratio: 9 / 14;
        min-height: 0;
        max-height: none;
      }
    }
  </style>
</head>

