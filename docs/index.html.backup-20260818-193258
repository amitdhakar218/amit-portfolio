  ========================================================== -->

  <div class="home-background-hero">

    <section
      class="hero section"
      id="home"
      style="padding-top:var(--space-2xl);"
    >

      <div class="hero-content">

        <p class="text-muted">
          Hello, I'm
        </p>

        <h1 class="hero-title home-name-yellow">
          Amit Dhakar
        </h1>

        <p class="hero-subtitle">
          Electronics & Communication Student · Developer ·
          Technology Enthusiast
        </p>

        <p class="hero-description">
          I am learning software development, app development,
          web technologies and artificial intelligence while
          building practical projects.
        </p>

        <!-- ONLY TWO LINKS -->
        <div class="home-social-links">

          <a
            href="https://github.com/amitdhakar218"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline home-social-link"
          >
            🐙 GitHub
          </a>

          <a
            href="https://www.linkedin.com/in/amit-dhakar-564177385"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline home-social-link"
          >
            💼 LinkedIn
          </a>

        </div>

        <div class="hero-buttons">

          <a href="#projects" class="btn btn-primary">
            🚀 View Projects
          </a>

          <a href="#contact" class="btn btn-outline">
            📩 Contact Me
          </a>

        </div>

      </div>

    </section>

  </div>


