// ==========================================
// SOCIAL LINKS RENDERING
// ==========================================

function renderSocialLinks(links) {

  const heroContainer =
    document.getElementById(
      "hero-social-links"
    );

  const homeHeroContainer =
    document.getElementById(
      "home-hero-social-links"
    );

  const contactContainer =
    document.getElementById(
      "contact-social-links"
    );

  const homeContactContainer =
    document.getElementById(
      "home-contact-social-links"
    );


  // ----------------------------------------
  // ONLY GITHUB + LINKEDIN IN HOME HERO
  // ----------------------------------------

  const heroLinks =
    links.filter(link => {

      const slug =
        getIconSlug(link.url);

      return (
        slug === "github" ||
        slug === "linkedin"
      );

    });


  const buildLinks =
    (list) => list.map(link => {

      const slug =
        getIconSlug(link.url);

      const label =
        slug
          ? slug.charAt(0).toUpperCase() +
            slug.slice(1)
          : "Link";

      return `
        <a
          href="${link.url}"
          class="btn btn-outline social-link-tracked"
          data-slug="${slug || ""}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="${label}"
        >
          <span class="social-icon">
            ${getSocialIcon(slug)}
          </span>
          <span>${label}</span>
        </a>
      `;

    }).join("");


  // Home hero

  if (homeHeroContainer) {

    homeHeroContainer.innerHTML =
      buildLinks(heroLinks);

  }


  // Existing hero container on older pages

  if (heroContainer) {

    heroContainer.innerHTML =
      buildLinks(heroLinks);

  }


  // Contact pages can still show ALL configured social links

  if (contactContainer) {

    contactContainer.innerHTML =
      buildLinks(links);

  }


  if (homeContactContainer) {

    homeContactContainer.innerHTML =
      buildLinks(links);

  }


  // Track social clicks

  document
    .querySelectorAll(
      ".social-link-tracked"
    )
    .forEach(a => {

      a.addEventListener(
        "click",
        () => {

          trackClick(
            a.dataset.slug
          );

        }
      );

    });
}


