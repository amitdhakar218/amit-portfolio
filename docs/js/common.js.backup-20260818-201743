// ==========================================
// SOCIAL LINKS RENDER
// ==========================================

function renderSocialLinks(links) {

  const heroContainer =
    document.getElementById(
      "hero-social-links"
    );

  const contactContainer =
    document.getElementById(
      "contact-social-links"
    );


  const buildLinks = () => {

    return links
      .map((link) => {

        const slug =
          getIconSlug(
            link.url
          );

        const label =
          slug
            ? slug.charAt(0).toUpperCase() +
              slug.slice(1)
            : "Link";

        return `
          <a
            href="${link.url}"
            class="btn btn-outline social-link-tracked"
            data-slug="${slug || ""}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="${label}"
          >

            <span class="social-icon">
              ${getSocialIcon(slug)}
            </span>

            <span>
              ${label}
            </span>

          </a>
        `;
      })
      .join("");
  };


  if (heroContainer) {

    heroContainer.innerHTML =
      buildLinks();
  }


  if (contactContainer) {

    contactContainer.innerHTML =
      buildLinks();
  }


  document
    .querySelectorAll(
      ".social-link-tracked"
    )
    .forEach((a) => {

      a.addEventListener(
        "click",
        () => {

          trackClick(
            a.dataset.slug
          );
        }
      );
    });
}


// ==========================================
// HOME CONTACT RENDER
// ==========================================

function renderHomeContact(data) {

  const container =
    document.getElementById(
      "home-contact-links"
    );

  if (!container) {
    return;
  }


  const contact =
    data.contact || {};


  const email =
    contact.email || "";


  const phone =
    contact.phone || "";


  let whatsapp =
    contact.whatsapp ||
    contact.whatsappNumber ||
    "";


  // ----------------------------------------
  // If WhatsApp is stored as wa.me URL
  // ----------------------------------------

  if (
    whatsapp &&
    !whatsapp.includes("://")
  ) {

    whatsapp =
      whatsapp.replace(
        /[^0-9]/g,
        ""
      );

    if (whatsapp) {

      whatsapp =
        `https://wa.me/${whatsapp}`;
    }
  }


  // ----------------------------------------
  // Build contact buttons
  // ----------------------------------------

  let html = "";


  if (email) {

    html += `
      <a
        href="mailto:${email}"
        class="btn btn-outline home-contact-link"
      >
        📧 Email
      </a>
    `;
  }


  if (phone) {

    html += `
      <a
        href="tel:${phone}"
        class="btn btn-outline home-contact-link"
      >
        📱 Call
      </a>
    `;
  }


  if (whatsapp) {

    html += `
      <a
        href="${whatsapp}"
        class="btn btn-primary home-contact-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        💬 WhatsApp
      </a>
    `;
  }


  // ----------------------------------------
  // Same social links as Contact page
  // ----------------------------------------

  const socialLinks =
    data.socialLinks || [];


  socialLinks.forEach((link) => {

    if (!link || !link.url) {
      return;
    }


    const slug =
      getIconSlug(
        link.url
      );


    const label =
      slug
        ? slug.charAt(0).toUpperCase() +
          slug.slice(1)
        : "Link";


    html += `
      <a
        href="${link.url}"
        class="btn btn-outline home-contact-link"
        target="_blank"
        rel="noopener noreferrer"
      >

        <span class="social-icon">
          ${getSocialIcon(slug)}
        </span>

        <span>
          ${label}
        </span>

      </a>
    `;
  });


  if (!html) {

    html =
      `<p class="text-muted">
        Contact information is not available yet.
      </p>`;
  }


  container.innerHTML =
    html;
}


