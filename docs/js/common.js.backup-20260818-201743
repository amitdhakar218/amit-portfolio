function initNavbarScroll() {

  const navbar =
    document.getElementById(
      "main-navbar"
    );

  if (!navbar) {
    return;
  }


  window.addEventListener(
    "scroll",
    () => {

      if (window.scrollY > 80) {

        navbar.classList.add(
          "scrolled"
        );

      } else {

        navbar.classList.remove(
          "scrolled"
        );
      }
    }
