async function loadProfileCommon() {

  try {

    profileData = null;


    // --------------------------------------
    // PRIMARY: FIREBASE
    // --------------------------------------

    if (
      typeof firebase !== "undefined" &&
      firebase.database
    ) {

      try {

        const snapshot =
          await firebase
            .database()
            .ref("profile")
            .once("value");

        profileData =
          snapshot.val();

      } catch (firebaseError) {

        console.warn(
          "Firebase profile read failed:",
          firebaseError
        );
      }
    }


    // --------------------------------------
    // FALLBACK: LOCAL JSON
    // --------------------------------------

    if (!profileData) {

      try {

        const res =
          await fetch(
            "shared/data/profile.json",
            {
              cache: "no-store"
            }
          );

        if (res.ok) {
          profileData =
            await res.json();
        }

