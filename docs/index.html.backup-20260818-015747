  <!-- =========================================================
       HOME ABOUT FIX
       Firebase से About/Profile data पढ़ना
  ========================================================== -->

  <script>
    document.addEventListener("DOMContentLoaded", async () => {

      const aboutEl =
        document.getElementById("home-about-content");

      if (!aboutEl) return;

      try {

        let profileData = null;

        /*
         * पहले Firebase Realtime Database से
         * संभावित profile/about locations पढ़ेंगे।
         */

        if (
          typeof firebase !== "undefined" &&
          firebase.database
        ) {

          const paths = [
            "profile",
            "about"
          ];

          for (const path of paths) {

            try {

              const snapshot =
                await firebase
                  .database()
                  .ref(path)
                  .once("value");

              const data = snapshot.val();

              if (data) {
                profileData = data;
                break;
              }

            } catch (firebasePathError) {

              console.warn(
                "Could not read Firebase path:",
                path,
                firebasePathError
              );

            }

          }

        }


        /*
         * Firebase data मिलने पर अलग-अलग possible
         * field names को support करेंगे।
         */

        if (profileData) {

          const text =
            profileData.intro ||
            profileData.about ||
            profileData.description ||
            profileData.bio ||
            profileData.content ||
            profileData.text ||
            "";

          if (text) {
            aboutEl.textContent = text;
          }

        }


        /*
         * अगर Firebase में About data नहीं मिला,
         * तो Loading हमेशा नहीं रहेगा।
         */

        if (
          !profileData ||
          !(
            profileData.intro ||
            profileData.about ||
            profileData.description ||
            profileData.bio ||
            profileData.content ||
            profileData.text
          )
        ) {

          aboutEl.textContent =
            "I am Amit Dhakar, an Electronics & Communication student interested in software development, app development, artificial intelligence and modern web technologies.";

        }

      } catch (error) {

        console.error(
          "Home About loading error:",
          error
        );

        aboutEl.textContent =
          "I am Amit Dhakar, an Electronics & Communication student interested in software development, app development, artificial intelligence and modern web technologies.";

      }

    });
  </script>

